{
  "expo": {
    "name": "Vera",
    "slug": "ezan-app",
    "version": "1.0.8",
    "orientation": "default",
    "icon": "./assets/images/Vera_app_icon.png",
    "scheme": "ezanapp",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdllhekc.vera",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.abdllhekc.vera",
      "googleServicesFile": "./google-services.json",
      "versionCode": 9,
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/images/Vera_app_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app/app.plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D",
          "dark": {
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan.mp3",
            "./assets/sounds/azizallah.mp3"
          ]
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "./plugins/withGoogleMobileAds.js",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0"
          }
        }
      ],
      "./plugins/withRemoveExpoAudioServices.js",
      "@react-native-firebase/auth/app.plugin.js",
      "./plugins/withAndroidSigning.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2afb534-f923-452a-adcc-df20a05fdcf1"
      }
    }
  }
}
