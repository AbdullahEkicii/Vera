{
  "expo": {
    "name": "Vera",
    "slug": "ezan-app",
    "version": "1.0.25",
    "orientation": "default",
    "icon": "./assets/images/Vera_app_icon.png",
    "scheme": "ezanapp",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdllhekc.vera",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSLocationWhenInUseUsageDescription": "Ezan vakitlerini ve kıble yönünü doğru hesaplayabilmek için konum izninize ihtiyaç duyulmaktadır.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Ezan vakitlerini ve kıble yönünü doğru hesaplayabilmek için konum izninize ihtiyaç duyulmaktadır.",
        "NSUserTrackingUsageDescription": "Size kişiselleştirilmiş reklamlar gösterebilmek ve uygulama deneyimini iyileştirebilmek için izninizi istiyoruz.",
        "NSPhotoLibraryUsageDescription": "Ayet, hadis ve duaları resim olarak kaydedebilmeniz için galeriye erişim izni gereklidir.",
        "NSPhotoLibraryAddUsageDescription": "Ayet ve dua görsellerini galerinize kaydetmek için izin gereklidir.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.abdllhekc.vera",
      "googleServicesFile": "./google-services.json",
      "versionCode": 27,
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/images/Vera_app_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app/app.plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D",
          "dark": {
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D4AF37",
          "sounds": [
            "./assets/sounds/adhan.mp3",
            "./assets/sounds/adhan_25minutes.mp3",
            "./assets/sounds/allahu_akbar.mp3",
            "./assets/sounds/azizallah.mp3"
          ]
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ezan vakitlerini ve kıble yönünü doğru hesaplayabilmek için konum izninize ihtiyaç duyulmaktadır.",
          "locationAlwaysPermission": "Ezan vakitlerini ve kıble yönünü doğru hesaplayabilmek için konum izninize ihtiyaç duyulmaktadır.",
          "locationWhenInUsePermission": "Ezan vakitlerini ve kıble yönünü doğru hesaplayabilmek için konum izninize ihtiyaç duyulmaktadır."
        }
      ],
      [
        "./plugins/withGoogleMobileAds.js",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "Size kişiselleştirilmiş reklamlar gösterebilmek ve uygulama deneyimini iyileştirebilmek için izninizi istiyoruz."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withRemoveExpoAudioServices.js",
      "@react-native-firebase/auth/app.plugin.js",
      "@react-native-firebase/analytics/app.plugin.js",
      "./plugins/withAndroidSigning.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2afb534-f923-452a-adcc-df20a05fdcf1"
      },
      "react-native-google-mobile-ads": {
        "android_app_id": "ca-app-pub-3940256099942544~3347511713",
        "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
      }
    }
  }
}
