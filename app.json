{
  "expo": {
    "name": "Vera",
    "slug": "ezan-app",
    "version": "1.0.39",
    "orientation": "portrait",
    "icon": "./assets/images/Vera_app_icon.png",
    "scheme": "ezanapp",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "hidden": false,
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdllhekc.vera",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSLocationWhenInUseUsageDescription": "Vera uses your location to calculate accurate prayer times and the Qibla direction.",
        "NSUserTrackingUsageDescription": "Your data is used to show you more relevant ads and to improve the app.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.abdllhekc.vera",
      "googleServicesFile": "./google-services.json",
      "versionCode": 41,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/images/Vera_app_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app/app.plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D",
          "dark": {
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D4AF37",
          "sounds": [
            "./assets/sounds/adhan.mp3",
            "./assets/sounds/adhan_25minutes.mp3",
            "./assets/sounds/allahu_akbar.mp3",
            "./assets/sounds/azizallah.mp3"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vera uses your location to calculate accurate prayer times and the Qibla direction.",
          "locationAlwaysAndWhenInUsePermission": "Vera uses your location to calculate accurate prayer times and the Qibla direction.",
          "locationAlwaysPermission": "Vera uses your location to calculate accurate prayer times and the Qibla direction."
        }
      ],
      [
        "./plugins/withGoogleMobileAds.js",
        {
          "androidAppId": "ca-app-pub-2034009761866400~5203875113",
          "iosAppId": "ca-app-pub-2034009761866400~5203875113",
          "userTrackingUsageDescription": "Your data is used to show you more relevant ads and to improve the app."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withRemoveExpoAudioServices.js",
      "@react-native-firebase/analytics/app.plugin.js",
      "./plugins/withAndroidSigning.js",
      "expo-background-task",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Size kişiselleştirilmiş reklamlar gösterebilmek ve uygulama deneyimini iyileştirebilmek için izninizi istiyoruz."
        }
      ],
      "@react-native-firebase/crashlytics/app.plugin.js",
      "@react-native-firebase/messaging/app.plugin.js",
      "./plugins/withRNFirebaseStaticFramework.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2afb534-f923-452a-adcc-df20a05fdcf1"
      },
      "react-native-google-mobile-ads": {
        "android_app_id": "ca-app-pub-2034009761866400~5203875113",
        "ios_app_id": "ca-app-pub-2034009761866400~5203875113"
      }
    },
    "locales": {
      "tr": "./locales/tr.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "ar": "./locales/ar.json",
      "id": "./locales/id.json",
      "ru": "./locales/ru.json",
      "ur": "./locales/ur.json",
      "ms": "./locales/ms.json",
      "fa": "./locales/fa.json"
    }
  }
}
