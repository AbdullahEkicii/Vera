rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anonymous in-app feedback (src/components/FeedbackModal.tsx): create-only.
    // The document id is chosen by the app (one id per submission), so a retry of the same
    // feedback can only be refused as an overwrite and never creates a second document.
    // The new fields are optional: apps already in the field send the older shape.
    match /app_feedback/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['message', 'language', 'platform', 'osVersion', 'appVersion', 'createdAt',
                          'submissionId', 'diag'])
                    && request.resource.data.keys().hasAll(['message', 'createdAt'])
                    && (!('submissionId' in request.resource.data)
                        || request.resource.data.submissionId == docId)
                    && (!('diag' in request.resource.data)
                        || (request.resource.data.diag is map && request.resource.data.diag.size() <= 12))
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && (!('language' in request.resource.data)
                        || (request.resource.data.language is string && request.resource.data.language.size() <= 20))
                    && (!('platform' in request.resource.data)
                        || (request.resource.data.platform is string && request.resource.data.platform.size() <= 20))
                    && (!('osVersion' in request.resource.data)
                        || (request.resource.data.osVersion is string && request.resource.data.osVersion.size() <= 40))
                    && (!('appVersion' in request.resource.data)
                        || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 40))
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Anonymous community feed (src/services/communityService.ts). Posts carry only allowlisted
    // template keys and bounded params; there is no free text.
    match /posts/{postId} {
      allow read: if resource.data.status == 'visible';

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['templateKey', 'params', 'lang', 'authorUid', 'dayKey', 'createdAt', 'status', 'reactionCounts', 'reportCount'])
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.dayKey is string
                    && request.resource.data.dayKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.status == 'visible'
                    && request.resource.data.reactionCounts == {}
                    && request.resource.data.reportCount == 0
                    && request.resource.data.lang is string && request.resource.data.lang.size() <= 10
                    && request.resource.data.templateKey in ['hatim.completed', 'achievement', 'dhikr.milestone', 'prayer.fullday']
                    && request.resource.data.params is map
                    && request.resource.data.params.keys().hasOnly(['count', 'country', 'title'])
                    && (!('count' in request.resource.data.params)
                        || (request.resource.data.params.count is int
                            && request.resource.data.params.count >= 1
                            && request.resource.data.params.count <= 1000000))
                    && (!('country' in request.resource.data.params)
                        || (request.resource.data.params.country is string
                            && request.resource.data.params.country.matches('[A-Z]{2}')))
                    && (!('title' in request.resource.data.params)
                        || (request.resource.data.params.title is string
                            && request.resource.data.params.title.size() <= 60));

      // Only the reaction counter may change on an existing post (the reaction transaction writes it).
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts'])
                    && request.resource.data.reactionCounts is map;

      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;

      match /reactions/{reactionId} {
        allow read: if request.auth != null
                    && (resource == null || resource.data.uid == request.auth.uid);
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['uid', 'postId', 'emoji', 'createdAt'])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.postId == postId
                      && request.resource.data.emoji in ['🤲', '❤️', '🎉', '🌙', '⭐']
                      && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // Collection-group read so a user can find their own reactions (loadMyReactions).
    match /{path=**}/reactions/{reactionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Reports: create-only, from the signed-in reporter.
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['postId', 'reason', 'reporterUid', 'createdAt'])
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.reason is string && request.resource.data.reason.size() <= 40;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
